rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn(); // Tạm thời nới lỏng: cho phép tài khoản chưa xác minh email (để test)
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'iloveu@gmail.com'; 
    }

    // Helper to validate timestamp
    function isValidTimestamp(ts) {
      return ts != null && ts is timestamp; // Đã bỏ giới hạn 5 phút để tránh lỗi do đồng hồ máy tính bị lệch
    }

    // --- COLLECTIONS ---

    // Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Wishlist
    match /wishlist/{wishId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.ten is string
        && request.resource.data.ten.size() >= 2 
        && request.resource.data.ten.size() <= 60
        && request.resource.data.uid == request.auth.uid;
      // Chủ sở hữu/admin được update toàn bộ
      // Bất kỳ user đăng nhập đều được update các trường social (likeCount, commentCount, pinnedBy, pinCount, isFavorite, favoriteAt)
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isAdmin() ||
        // Non-owner chỉ được phép update các counter social
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likeCount', 'commentCount', 'pinnedBy', 'pinCount', 'isFavorite', 'favoriteAt'])
      );
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Folders
    match /folders/{folderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid || 
        isAdmin() ||
        (resource.data.groupId != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members)
      );
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.members || isAdmin());
      allow create: if isEmailVerified();
      allow update: if isEmailVerified() && (request.auth.uid in resource.data.members || isAdmin());
      allow delete: if isEmailVerified() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Likes
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Comments & Replies
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 500;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /replies/{replyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 500;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn(); // Bất kỳ user đăng nhập đều có thể tạo notification cho người khác
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
